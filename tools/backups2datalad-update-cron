#!/bin/bash
# Just the update portion
source "$(dirname "$0")"/backups2datalad-cron-common

(
# Private LINC likely never to get open:
# https://dandiarchive.org/dandiset/001412 - private macaque
# https://dandiarchive.org/dandiset/001411 - private human, zarrbargo and likely never to see open
# 001449 - TEMP spaces. https://github.com/dandi/backups2datalad/issues/103
backups2datalad \
   -l WARNING \
   --backup-root "$backup_root" \
   --config tools/backups2datalad.cfg.yaml \
   update-from-backup \
   --workers 5 \
   -e '00(1412|1411|1449)$' \
   "$@" 2>&1 | grep -v 'nothing to save, working tree clean'

git pull --commit --no-edit
datalad push -J 5
) 2>|.git/tmp/stderr-2

if [ -s .git/tmp/stderr-2 ]; then
	echo "There was stderr from backup/datalad invocations:"
	cat .git/tmp/stderr-2
fi

# we must be clean
# TODO: disable temporarily since 000108 is problematic
# git diff --exit-code
